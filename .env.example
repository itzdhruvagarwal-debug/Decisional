# ==========================================
# DECISIONAL - VERCEL FREE TIER CONFIGURATION
# ==========================================

# Set to true on Vercel to bypass strict production checks for unconfigured paid APIs
SKIP_ENV_VALIDATION="true"
NODE_ENV="production"

# App URLs (replace with your Vercel URL, e.g. https://decisional.vercel.app)
NEXTAUTH_URL="https://your-app-name.vercel.app"
NEXT_PUBLIC_APP_URL="https://your-app-name.vercel.app"
APP_BASE_URL="https://your-app-name.vercel.app"

# NextAuth v5 Secrets (Generate with: openssl rand -base64 32)
NEXTAUTH_SECRET="replace-with-openssl-rand-base64-32"
AUTH_SECRET="replace-with-openssl-rand-base64-32"

# Database - Supabase (Free Tier)
# Direct connection for migrations (port 5432)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"
# Transaction Pooler for Vercel Serverless (port 6543) - REQUIRED
PGBOUNCER_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true&connection_limit=1"

# Cache & Rate Limiting - Upstash Redis (Free Tier)
# TLS connection string starting with rediss://
REDIS_URL="rediss://default:[PASSWORD]@[YOUR-ENDPOINT].upstash.io:6379"

# Storage
STORAGE_PROVIDER="local"

# Security & Cryptography (Generate with: openssl rand -hex 32)
CRON_SECRET="replace-with-openssl-rand-hex-32"
CONTRACT_SIGNING_SECRET="replace-with-openssl-rand-hex-32"
HMAC_KEY="replace-with-openssl-rand-hex-32"
ENCRYPTION_KEYS="v1:e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"

# Payments - Razorpay (Free Test Mode)
RAZORPAY_KEY_ID="rzp_test_YourKeyId"
RAZORPAY_KEY_SECRET="YourKeySecret"
RAZORPAY_WEBHOOK_SECRET="test_webhook_secret"

# Verification & Compliance
KYC_PROVIDER="manual"
LOG_LEVEL="info"
